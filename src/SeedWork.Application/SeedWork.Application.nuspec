<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SeedWork.Application</id>
    <version>$version$</version>
    <authors>SeedWork</authors>
    <description>Use cases and generated dependency injection pipelines for .NET 11 applications.</description>
    <readme>README.md</readme>
    <dependencies>
      <group targetFramework="net11.0">
        <dependency id="Microsoft.Extensions.DependencyInjection" version="[11.0.0, )" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin/$configuration$/net11.0/SeedWork.Application.dll" target="lib/net11.0" />
    <file src="bin/$configuration$/net11.0/SeedWork.Application.xml" target="lib/net11.0" />
    <file src="bin/$configuration$/netstandard2.0/SeedWork.Application.Generators.dll" target="analyzers/dotnet/cs" />
    <file src="README.md" target="" />
  </files>
</package>
